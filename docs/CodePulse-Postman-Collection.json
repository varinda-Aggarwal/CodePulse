        },
        {
          "name": "Add Topic",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    const id = data._id || (data.topic && data.topic._id);",
                  "    if (id) pm.collectionVariables.set('topicId', id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dynamic Programming\",\n  \"status\": \"Not Started\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/topics",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "topics"
              ]
            },
            "description": "Creates a new topic for the logged-in user. Topic name must be unique per-user (case-insensitive check).\n\n**Errors:** 400 validation / duplicate name."
          },
          "response": []
        },
        {
          "name": "Update Topic",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dynamic Programming\",\n  \"status\": \"Done\",\n  \"needsRevision\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/topics/{{topicId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "topics",
                "{{topicId}}"
              ]
            },
            "description": "Updates a topic (name and/or status). Setting status to 'Done' auto-sets completedAt; changing away from 'Done' clears it. Ownership is checked \u2014 401 if the topic doesn't belong to the logged-in user.\n\n**Errors:** 400 validation / duplicate name on rename, 401 not owner, 404 not found.\n\nneedsRevision is not accepted on creation (POST only reads name/status), but is settable here since PUT forwards the full body unfiltered to the database update."
          },
          "response": []
        },
        {
          "name": "Delete Topic",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/topics/{{topicId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "topics",
                "{{topicId}}"
              ]
            },
            "description": "Deletes a topic. Ownership is checked.\n\n**Errors:** 401 not owner, 404 not found."
          },
          "response": []
        }
      ]
    },
