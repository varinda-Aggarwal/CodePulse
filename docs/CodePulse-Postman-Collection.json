    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "56799833",
    "_collection_link": "https://go.postman.co/collection/56799833-f258f3ba-c345-4ec2-937f-49f7a738d3a2?source=collection_link"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    if (data.token) pm.collectionVariables.set('token', data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"your_email@example.com\",\n  \"password\": \"yourpassword\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Authenticate an existing user with email + password. Rate-limited: 5 attempts / 15 min (loginLimiter). Returns JWT token plus user profile fields (_id, username, email, firstName, lastName, photo, token).\n\n**Errors:** 400 validation, 401 invalid credentials, 429 too many attempts."
          },
          "response": []
        },
        {
          "name": "Send OTP (Signup)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"varinda\",\n  \"email\": \"your_email@example.com\",\n  \"phone\": \"9876543210\",\n  \"password\": \"Passw0rd!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/send-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "send-otp"
              ]
            },
            "description": "Step 1 of signup. Sends a 6-digit OTP to the given email (valid 5 min, auto-expires via MongoDB TTL). Rate-limited: 5 requests / 15 min (otpLimiter). Password must be 8+ chars with upper, lower, digit, special char (@$!%*?&#).\n\n**Errors:** 400 validation, 429 too many requests."
          },
          "response": []
        },
        {
          "name": "Verify OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const data = pm.response.json();",
                  "    if (data.token) pm.collectionVariables.set('token', data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"your_email@example.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-otp"
              ]
            },
            "description": "Step 2 of signup. Verifying the correct OTP creates the User account and returns a JWT token (no firstName/photo yet, since account is brand new). Rate-limited: 5 requests / 15 min (otpLimiter, shared with send-otp).\n\n**Errors:** 400 validation / invalid or expired OTP, 429 too many requests."
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"your_email@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "forgot-password"
              ]
            },
            "description": "Sends a password reset link (valid 15 min) if the email exists. Always returns a generic success message regardless of whether the email exists, to avoid leaking which emails are registered. Rate-limited: 3 requests / 15 min, keyed by IP+email (forgotPasswordLimiter).\n\n**Errors:** 400 validation, 429 too many requests."
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"NewPassw0rd!\",\n  \"confirmPassword\": \"NewPassw0rd!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password/:token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "reset-password",
                ":token"
              ],
              "variable": [
                {
                  "key": "token"
                }
              ]
            },
            "description": "Completes password reset using the token from the reset email link. Same rate limiter as Forgot Password.\n\nReplace `:token` in the URL with the actual token from the email link before sending.\n\n**Errors:** 400 validation / passwords don't match / invalid or expired token, 429 too many requests."
          },
          "response": []
        },
        {
          "name": "Google OAuth - Start",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/google",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "google"
              ]
            },
            "description": "Redirects to Google's account picker (prompt: select_account) to begin OAuth login/signup. This is a browser-redirect flow, not a typical JSON API call \u2014 open this URL directly in a browser tab to test, not via Postman's Send button."
          },
          "response": []
        },
        {
          "name": "Google OAuth - Callback",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/google/callback",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "google",
                "callback"
              ]
            },
            "description": "Google redirects here after the user picks an account. Server creates the user (if new) or logs them in (if googleId or matching email already exists), then redirects to the frontend with a token. Not directly callable \u2014 this fires automatically as part of the browser OAuth flow above."
          },
          "response": []
        }
      ]
    },
